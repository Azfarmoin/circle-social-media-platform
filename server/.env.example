# Copy to server/.env for local development. Every value has a safe development default;
# in production (NODE_ENV=production) the variables marked REQUIRED must be set.
NODE_ENV=development
PORT=5000
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/circle
# MongoDB Atlas (cloud). Replace USER, PASSWORD (URL-encoded) and the cluster host, and keep the database name (/circle):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/circle?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/circle
# Optional. Without it the cache and rate-limit counters live in process memory.
REDIS_URL=
CLIENT_URL=http://localhost:5173
# Set true when running behind a reverse proxy / load balancer so client IPs are read correctly.
TRUST_PROXY=false

# REQUIRED in production: a long random string (openssl rand -hex 48)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
# Secure cookies need HTTPS (localhost is exempt in browsers). Defaults to true in production.
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=true

RATE_LIMIT_DISABLED=false
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40

UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=

# Without SMTP_URL, emails are written to an in-memory outbox and the verify link is returned by the API in development.
SMTP_URL=
MAIL_FROM=Circle <no-reply@circle.local>
LOG_LEVEL=info

# true = fill an EMPTY database with demo people and posts when the server starts (never touches a database that already has users)
AUTO_SEED=false
